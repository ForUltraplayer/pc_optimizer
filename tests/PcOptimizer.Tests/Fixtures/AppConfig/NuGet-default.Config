<?xml version="1.0" encoding="utf-8"?>
<!--
  @file    : NuGet-default.Config
  @author  : rudals252
  @brief   : NuGet 설정 리더 테스트용 가짜 사용자 NuGet.Config(globalPackagesFolder 없음, config 밖의 같은 키 이름은 무시)
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="globalPackagesFolder" value="Z:\NotAConfigEntry" />
  </packageSources>
</configuration>
