<?xml version="1.0" encoding="utf-8"?>
<!--
  @file    : NuGet-override.Config
  @author  : rudals252
  @brief   : NuGet 설정 리더 테스트용 가짜 사용자 NuGet.Config(globalPackagesFolder 재정의와 가짜 평문 비밀번호·API 키 포함, 실제 자격 증명 아님)
-->
<configuration>
  <packageSources>
    <add key="private" value="https://nuget.example.invalid/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <private>
      <add key="Username" value="fakeuser" />
      <add key="ClearTextPassword" value="NUGETFAKESECRET555" />
    </private>
  </packageSourceCredentials>
  <apikeys>
    <add key="https://nuget.example.invalid" value="NUGETFAKEAPIKEY777" />
  </apikeys>
  <config>
    <add key="http_proxy" value="http://proxy.example.invalid" />
    <add key="globalPackagesFolder" value="D:\NuGetPackages" />
  </config>
</configuration>
