<!--
@file    : VisibilityTheme.xaml
@author  : rudals252
@brief   : 짙은 창 프레임과 읽기 쉬운 밝은 본문, 공통 경계·텍스트·스크롤바 팔레트
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppCanvasBrush" Color="#DCE4EF" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppInsetBrush" Color="#E8EEF6" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#7D8FA8" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#17243B" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#40516B" />
    <SolidColorBrush x:Key="AppChromeBrush" Color="#142238" />
    <SolidColorBrush x:Key="AppSidebarBrush" Color="#22344F" />
    <SolidColorBrush x:Key="AppOnDarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppOnDarkMutedBrush" Color="#D5E2F3" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#214FBE" />
    <SolidColorBrush x:Key="AppSelectedBrush" Color="#3266CF" />
    <Style x:Key="AppScrollThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="#61758F" CornerRadius="5" Margin="3,1" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#304D74" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#214FBE" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 가로 막대는 기본 스타일을 유지하고 세로 막대는 항상 식별 가능한 폭을 사용한다. -->
    <Style TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="16" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                    <Border Background="#CBD5E3" CornerRadius="6">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource AppScrollThumb}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" /></Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
