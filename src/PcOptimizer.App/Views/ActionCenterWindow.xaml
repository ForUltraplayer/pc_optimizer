<!--
@file    : ActionCenterWindow.xaml
@author  : rudals252
@brief   : 확인·실행·결과·되돌리기를 한 창에서 표시, 창 닫기와 작업 중단을 분리
-->
<Window x:Class="PcOptimizer.App.Views.ActionCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="조치 기록 · 되돌리기" Width="760" Height="820" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" Foreground="#19253B"
        FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#253652" />
            <Setter Property="BorderBrush" Value="#CCD5E2" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#122E73" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#DDE4EF" /><Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Grid Background="#F4F6FA"><DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="선택한 조치와 결과를 확인하세요" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="변경할 내용을 먼저 확인하고 실행합니다. 창을 닫아도 진행 중인 작업과 결과 기록은 유지됩니다." Foreground="#53627A" Margin="0,8,0,12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="ActionStatus" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
            <WrapPanel>
                <Button Content="중단 요청" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelAction" />
                <Button Content="창 닫기 (Esc)" IsCancel="True" Click="CloseWindow" AutomationProperties.AutomationId="CloseActionCenter" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Benefit}" Margin="0,6,0,12" />
                            <Button Content="대상과 효과 확인" HorizontalAlignment="Left"
                                Command="{Binding DataContext.PrepareChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="검사·조치 또는 종료 확인이 진행 중입니다. 실행 버튼은 실제 작업이 끝난 뒤 사용할 수 있습니다."
                           Visibility="{Binding IsBlocked, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="ActionBusyNote" Foreground="#915800" Margin="0,0,0,14" />
                <Border Style="{StaticResource Card}" Visibility="{Binding HasPreview, Converter={StaticResource Visible}}" Background="#EDF4FF">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Preview}">
                            <TextBlock Text="실행 전 확인" FontWeight="SemiBold" Foreground="#2855D9" />
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,10" />
                            <TextBlock Text="{Binding Summary}" />
                            <TextBlock Text="{Binding Impact}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Restore}" Margin="0,6,0,12" />
                            <TextBlock Text="변경 대상" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Target}" AutomationProperties.AutomationId="ActionTarget" Margin="0,4,0,10" />
                            <TextBlock Text="{Binding Estimate}" Visibility="{Binding HasSpaceEstimate, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Safety}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Restart}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Expiry}" FontSize="12" Foreground="#53627A" Margin="0,10,0,14" />
                        </StackPanel>
                        <WrapPanel>
                            <!-- Enter 단독 입력이 확인 전 실행을 일으키지 않도록 기본 버튼으로 지정하지 않는다. -->
                            <Button Content="확인한 내용 실행" Command="{Binding ExecuteCommand}" Background="#2855D9" Foreground="White" BorderBrush="#2855D9" AutomationProperties.AutomationId="ConfirmAction" />
                            <Button Content="실행하지 않기" Command="{Binding DismissPreviewCommand}" AutomationProperties.AutomationId="DismissAction" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Result}">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="ActionResultTitle" />
                            <TextBlock Text="{Binding ActionName}" Foreground="#53627A" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding Detail}" />
                            <TextBlock Text="{Binding Estimate}" Margin="0,12,0,6" Visibility="{Binding HasSpaceEffect, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Actual}" FontWeight="SemiBold" AutomationProperties.AutomationId="ActionActualEffect" Visibility="{Binding HasSpaceEffect, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding FileCounts}" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding RescanStatus}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="변경 기록과 되돌리기" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HistoryStatus}" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="기록 다시 확인" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Padding="0,14" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Margin="0,5,0,5" />
                                            <TextBlock Text="{Binding Availability}" Foreground="#53627A" Margin="0,0,0,10" />
                                            <Button Content="되돌리기 전 확인" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Expander Header="이번 실행의 이전 결과" IsExpanded="False">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,10"><TextBlock Text="{Binding ActionName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Detail}" /></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel></Grid>
</Window>
