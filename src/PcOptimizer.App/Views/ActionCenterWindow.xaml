<!--
@file    : ActionCenterWindow.xaml
@author  : rudals252
@brief   : 조치 화면을 별도 창으로 띄우는 얇은 래퍼(본문은 ActionCenterView), 창 닫기와 작업 중단을 분리
-->
<Window x:Class="PcOptimizer.App.Views.ActionCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PcOptimizer.App.Views"
        Title="개선할 작업 선택 · 결과 · 되돌리기" Width="760" Height="820" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" Foreground="#19253B"
        FontFamily="Segoe UI, Malgun Gothic">
    <DockPanel Margin="22">
        <Button DockPanel.Dock="Bottom" Content="창 닫기 (Esc)" IsCancel="True" Click="CloseWindow" HorizontalAlignment="Left" Padding="14,9" Margin="0,8,0,0" AutomationProperties.AutomationId="CloseActionCenter" />
        <views:ActionCenterView />
    </DockPanel>
</Window>
