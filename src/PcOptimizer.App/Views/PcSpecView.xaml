<!--
@file    : PcSpecView.xaml
@author  : rudals252
@brief   : 내 PC 사양 화면. fastfetch처럼 한 열로 머리글 줄, "[섹션]" 제목 줄, "라벨: 값" 줄(값이 길면 라벨 아래로 줄바꿈), 확인 불가 섹션 안내 한 줄을 나열하고, 새로 고침·텍스트 복사·TXT 저장·이미지 저장·식별 정보 포함 토글과 하단 익명화 표기를 둔다. 이전 사양 읽기의 프로브가 아직 끝나지 않았으면 종료 대기 안내를 보인다
-->
<UserControl x:Class="PcOptimizer.App.Views.PcSpecView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:PcOptimizer.App.Resources"
    xmlns:vm="clr-namespace:PcOptimizer.App.ViewModels"
    UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 한 열 목록의 줄 종류별 모양: 섹션 제목(굵게), 항목(라벨 회색 고정 폭 + 값), 확인 불가 안내. 칸(2열 Grid·타일)으로 나누지 않는다. -->
        <DataTemplate DataType="{x:Type vm:PcSpecSectionViewModel}">
            <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" Foreground="#19253B" Margin="0,12,0,4" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PcSpecItemViewModel}">
            <WrapPanel Margin="0,1,0,1">
                <TextBlock Text="{Binding LabelText}" MinWidth="120" Foreground="#53627A" Margin="0,0,8,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ValueText}" Foreground="#19253B" TextWrapping="Wrap" />
            </WrapPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PcSpecNoteLineViewModel}">
            <TextBlock Text="{Binding Text}" Foreground="#644300" Margin="0,1,0,1" TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Spec_NavOpen}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <WrapPanel Margin="0,12,0,4">
            <Button Content="{x:Static res:Strings.Spec_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="SpecRefreshButton" />
            <Button Content="{x:Static res:Strings.Spec_CopyText}" Command="{Binding CopyTextCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="SpecCopyTextButton" />
            <Button Content="{x:Static res:Strings.Spec_SaveText}" Command="{Binding SaveTextCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="SpecSaveTextButton" />
            <Button Content="{x:Static res:Strings.Spec_SaveImage}" Command="{Binding SaveImageCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="SpecSaveImageButton" />
            <CheckBox Content="{x:Static res:Strings.Spec_IncludeIdentity}" IsChecked="{Binding IncludeIdentity}" VerticalAlignment="Center" Margin="4,0,0,8"
                      AutomationProperties.AutomationId="SpecIncludeIdentityToggle" />
        </WrapPanel>
        <TextBlock Text="{x:Static res:Strings.Spec_Loading}" Foreground="#53627A" Margin="0,0,0,6" TextWrapping="Wrap"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{x:Static res:Strings.Spec_BusyScanning}" Foreground="#644300" Margin="0,0,0,6" TextWrapping="Wrap"
                   Visibility="{Binding IsScanBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{x:Static res:Strings.Spec_DrainingNote}" Foreground="#644300" Margin="0,0,0,6" TextWrapping="Wrap" AutomationProperties.AutomationId="SpecDrainingNote"
                   Visibility="{Binding IsDraining, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,6" TextWrapping="Wrap" AutomationProperties.AutomationId="SpecStatusMessage"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
        <!-- 이미지 저장 대상: 머리글·한 열 목록·하단 익명화 표기를 함께 렌더한다(흰 배경). -->
        <Border x:Name="CaptureRoot" x:FieldModifier="public" Background="White" BorderBrush="#E0E5EE" BorderThickness="1" CornerRadius="8" Padding="20,16"
                AutomationProperties.AutomationId="SpecCaptureRoot">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding HeaderLines}" Focusable="False" AutomationProperties.AutomationId="SpecHeaderLines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#19253B" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" AutomationProperties.AutomationId="SpecLines" />
                <TextBlock Text="{Binding IdentityMarker}" Foreground="#53627A" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="SpecIdentityMarker" />
                <TextBlock Text="{x:Static res:Strings.Spec_MoreDetails}" Foreground="#53627A" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
