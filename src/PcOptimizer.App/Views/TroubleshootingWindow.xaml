<!--
@file    : TroubleshootingWindow.xaml
@author  : rudals252
@brief   : 문제 해결 도구함을 별도 창으로 띄우는 얇은 래퍼(본문은 TroubleshootingView)
-->
<Window x:Class="PcOptimizer.App.Views.TroubleshootingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PcOptimizer.App.Views"
        Title="문제 해결 도구" Width="1000" Height="820" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppCanvasBrush}" Foreground="{DynamicResource AppTextBrush}"
        FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources><ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PcOptimizer;component/Resources/VisibilityTheme.xaml" /></ResourceDictionary.MergedDictionaries>
</ResourceDictionary></Window.Resources>
    <views:TroubleshootingView Margin="20" />
</Window>
