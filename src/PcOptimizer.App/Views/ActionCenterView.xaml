<!--
@file    : ActionCenterView.xaml
@author  : rudals252
@brief   : 조치 선택·확인·실행·결과·되돌리기 뷰(메인 창 페이지와 얇은 창 래퍼가 공유)
-->
<UserControl x:Class="PcOptimizer.App.Views.ActionCenterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PcOptimizer.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PcOptimizer;component/Resources/VisibilityTheme.xaml" /></ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#253652" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#122E73" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
            </ResourceDictionary>
    </UserControl.Resources>
    <Grid><DockPanel Margin="0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Text="어떤 점을 개선할까요?" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="① 원하는 효과 선택  →  ② 대상·영향 확인  →  ③ 실행·재검사
되돌릴 수 있는 설정은 아래 변경 기록에서 복원합니다." TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,8,0,12" />
            <WrapPanel>
                <Button Content="전체 작업" Command="{Binding SelectEffectCommand}" CommandParameter="all" />
                <Button Content="공간 확보" Command="{Binding SelectEffectCommand}" CommandParameter="space" />
                <Button Content="자동 실행 줄이기" Command="{Binding SelectEffectCommand}" CommandParameter="startup" />
                <Button Content="전원 선택" Command="{Binding SelectEffectCommand}" CommandParameter="power" />
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="ActionStatus" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
            <WrapPanel>
                <Button Content="중단 요청" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelAction" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer services:ScrollChain.IsEnabled="True" x:Name="ActionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="검사·조치 또는 종료 확인이 진행 중입니다. 실행 버튼은 실제 작업이 끝난 뒤 사용할 수 있습니다."
                           Visibility="{Binding IsBlocked, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="ActionBusyNote" Foreground="#915800" Margin="0,0,0,14" />
                <Border Style="{StaticResource Card}" Visibility="{Binding HasPreview, Converter={StaticResource Visible}}" Background="#EDF4FF">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Preview}">
                            <TextBlock TextWrapping="Wrap" Text="실행 전 확인" FontWeight="SemiBold" Foreground="#2855D9" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding SafetyLabel}" Foreground="#915800" Margin="0,6,0,0" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,10" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Summary}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Impact}" Margin="0,6,0,0" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Restore}" Margin="0,6,0,12" />
                            <TextBlock TextWrapping="Wrap" Text="변경 대상" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Target}" AutomationProperties.AutomationId="ActionTarget" Margin="0,4,0,10" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Estimate}" Visibility="{Binding HasSpaceEstimate, Converter={StaticResource Visible}}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Safety}" Margin="0,6,0,0" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Restart}" Margin="0,6,0,0" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Expiry}" FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,10,0,14" />
                        </StackPanel>
                        <WrapPanel>
                            <!-- Enter 단독 입력이 확인 전 실행을 일으키지 않도록 기본 버튼으로 지정하지 않는다. -->
                            <Button Content="확인한 내용 실행" Command="{Binding ExecuteCommand}" Background="#2855D9" Foreground="White" BorderBrush="#2855D9" AutomationProperties.AutomationId="ConfirmAction" />
                            <Button Content="실행하지 않기" Command="{Binding DismissPreviewCommand}" AutomationProperties.AutomationId="DismissAction" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Result}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="ActionResultTitle" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding ActionName}" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,4,0,12" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Detail}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Estimate}" Margin="0,12,0,6" Visibility="{Binding HasSpaceEffect, Converter={StaticResource Visible}}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Actual}" FontWeight="SemiBold" AutomationProperties.AutomationId="ActionActualEffect" Visibility="{Binding HasSpaceEffect, Converter={StaticResource Visible}}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding FileCounts}" Margin="0,8,0,0" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding CacheObservation}" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding RescanStatus}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock TextWrapping="Wrap" Text="원하는 효과로 작업 찾기" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8" />
                <TextBlock TextWrapping="Wrap" Text="현재 사용자 범위에서 지원하는 항목입니다. 사용할 수 없는 도구는 표시하지 않으며, 실제 대상과 설치 상태는 미리보기에서 다시 확인합니다." Margin="0,0,0,14" />
                <TextBlock Text="{Binding ChoiceNotice}" TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding ChoiceGroups}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Expander Header="{Binding Header}" HorizontalContentAlignment="Stretch" IsExpanded="True" Margin="0,0,0,14">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" Text="{Binding Description}" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Benefit}" Margin="0,6,0,12" />
                            <Button Content="대상과 효과 확인" HorizontalAlignment="Left"
                                Command="{Binding DataContext.PrepareChoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="앱 캐시 위치 직접 선택 · Adobe / Steam / 영상 편집" IsExpanded="False" Margin="0,0,0,18">
                    <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Card}" Visibility="{Binding CanSelectAdobeLocation, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="Adobe 캐시를 다른 드라이브로 옮겼나요?" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Text="Adobe 환경설정에서 캐시 위치를 확인한 뒤 Media Cache Files 또는 Peak Files 폴더를 선택하세요. 90일 이상 된 오디오·파형 파일만 미리 확인하며, 실행 버튼을 누르기 전에는 삭제하지 않습니다." Margin="0,6,0,10" />
                        <Button Content="옮긴 Adobe 캐시 폴더 선택" HorizontalAlignment="Left" Command="{Binding SelectAdobeFolderCommand}" AutomationProperties.AutomationId="SelectAdobeCacheFolder" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding CanSelectVideoLocations, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="영상 편집 캐시 위치 직접 지정" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Text="기본 위치에서 찾지 못한 캐시나 다른 드라이브로 옮긴 캐시를 검사합니다. 앱 설정에서 위치를 확인한 뒤 선택하세요. 용량만 조회하며 삭제하지 않습니다. 선택은 이 앱을 종료하면 해제됩니다." Margin="0,6,0,10" />
                        <WrapPanel>
                            <Button Content="Resolve CacheClip 선택" Command="{Binding SelectVideoFolderCommand}" CommandParameter="davinci" />
                            <Button Content="CapCut Cache 선택" Command="{Binding SelectVideoFolderCommand}" CommandParameter="capcut" />
                            <Button Content="기본 위치로 검사" Command="{Binding ResetVideoFoldersCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding CanSelectSteamLocation, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="Steam 라이브러리별 셰이더 캐시 정리" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Text="검사 결과에서 위치를 확인한 뒤 해당 라이브러리의 steamapps\shadercache 폴더를 선택하세요. 30일 이상 된 파일만 미리 확인합니다. Steam·게임을 닫아 주세요. Program Files 등 보호 위치는 직접 정리하지 않습니다." Margin="0,6,0,10" />
                        <Button Content="Steam shadercache 폴더 선택" HorizontalAlignment="Left" Command="{Binding SelectSteamFolderCommand}" AutomationProperties.AutomationId="SelectSteamCacheFolder" />
                    </StackPanel>
                </Border>
                    </StackPanel>
                </Expander>
                <Expander Header="Windows·기존 앱에서 직접 조치" IsExpanded="True" Margin="0,0,0,18">
                    <ItemsControl ItemsSource="{Binding ManualChoices}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Reason}" Margin="0,6,0,12" />
                            <Button Content="Windows 설정 열기" HorizontalAlignment="Left" Visibility="{Binding HasSettings, Converter={StaticResource Visible}}"
                                Command="{Binding DataContext.OpenManualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Content="공식 안내 열기" HorizontalAlignment="Left" Visibility="{Binding HasSupport, Converter={StaticResource Visible}}"
                                Command="{Binding DataContext.OpenSupportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Expander>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="변경 기록과 되돌리기" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding HistoryStatus}" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="기록 다시 확인" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Detail}" Margin="0,5,0,5" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Availability}" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,10" />
                                            <Button Content="되돌리기 전 확인" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Expander Header="이번 실행의 이전 결과" IsExpanded="False">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,10"><TextBlock TextWrapping="Wrap" Text="{Binding ActionName}" FontWeight="SemiBold" /><TextBlock TextWrapping="Wrap" Text="{Binding Title}" /><TextBlock TextWrapping="Wrap" Text="{Binding Detail}" /></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel></Grid>
</UserControl>
