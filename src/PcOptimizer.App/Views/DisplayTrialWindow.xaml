<!--
@file    : DisplayTrialWindow.xaml
@author  : rudals252
@brief   : 실제 기능 평가용 주사율 선택·시험·유지·기록 복구 화면
-->
<Window x:Class="PcOptimizer.App.Views.DisplayTrialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PcOptimizer.App.Services"
        Title="주사율 시험 적용 · 되돌리기" Width="650" Height="720" MinWidth="450" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PcOptimizer;component/Resources/VisibilityTheme.xaml" /></ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,0,8,8" /></Style>
            </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="22" Background="{DynamicResource AppCanvasBrush}">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Countdown}" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel>
                <Button Content="유지" Command="{Binding KeepCommand}" />
                <Button Content="원래대로" Command="{Binding RevertCommand}" />
                <Button Content="닫기 / 시험 중단" Click="CloseWindow" IsCancel="True" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ScrollViewer services:ScrollChain.IsEnabled="True" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="주사율 시험 적용" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="같은 해상도의 지원 주사율을 잠시 적용합니다. 15초 안에 유지하지 않으면 원복을 시도합니다. 이 기능의 실제 화면 전환 검증은 아직 완료되지 않았습니다. 앱 강제 종료·전원 차단·드라이버 응답 정지 중에는 원복을 보장하지 않습니다." />
            <Button Content="모드·복구 기록 다시 확인" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" Margin="0,4,0,12" />
            <Button Content="선택한 모드 사전 확인" Command="{Binding PrepareCommand}" HorizontalAlignment="Left" />
            <Border Padding="14" Background="White" Margin="0,8,0,16" Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
                <StackPanel><TextBlock Text="{Binding Preview}" /><Button Content="확인한 내용 실행" Command="{Binding ExecuteCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <TextBlock Text="중단 기록 · 되돌리기" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="White" Padding="14" Margin="0,0,0,12"><StackPanel>
                    <TextBlock><Run Text="기록된 원래 주사율: " /><Run Text="{Binding BeforeHz}" /><Run Text=" Hz / 적용 주사율: " /><Run Text="{Binding AppliedHz}" /><Run Text=" Hz" /></TextBlock>
                    <TextBlock Text="중단된 시험입니다. 표시 상태와 복구 결과를 확인하세요." Visibility="{Binding NeedsRecovery, Converter={StaticResource Visible}}" />
                    <Button Content="되돌릴 내용 확인" Command="{Binding DataContext.PrepareRestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
