<ui:FluentWindow x:Class="PcOptimizer.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PcOptimizer.App.Resources"
    xmlns:vm="clr-namespace:PcOptimizer.App.ViewModels"
    xmlns:models="clr-namespace:PcOptimizer.Core.Models;assembly=PcOptimizer.Core"
    Title="{x:Static res:Strings.MainWindow_Title}" Width="1180" Height="820" MinWidth="720" MinHeight="480"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    WindowCornerPreference="Round" Background="#F4F6FA" Foreground="#19253B" FontFamily="Segoe UI, Malgun Gothic"
    KeyboardNavigation.TabNavigation="Cycle">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#253652" />
            <Setter Property="BorderBrush" Value="#CCD5E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#122E73" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2855D9" /><Setter Property="BorderBrush" Value="#2855D9" />
            <Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,12,8,0" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#53627A" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" /><Setter Property="BorderBrush" Value="#E0E5EE" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="VerdictBadge" TargetType="Border">
            <Setter Property="Background" Value="#EDF1F6" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="8,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Static models:Verdict.Candidate}"><Setter Property="Background" Value="#FFF0CC" /></DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Static models:Verdict.Ok}"><Setter Property="Background" Value="#DDF3E8" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:FindingCardViewModel}">
            <Border Style="{StaticResource Tile}" Margin="0,0,0,12" Padding="22,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource VerdictBadge}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding VerdictText}" Foreground="#263650" FontSize="12" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" Text="{Binding CategoryText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                    <WrapPanel Visibility="{Binding IsKept, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Card_KeptNote}" MaxWidth="530" VerticalAlignment="Center" />
                        <Button Content="{x:Static res:Strings.Button_Unkeep}" Command="{Binding UnkeepCommand}" Margin="8,0,0,0" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="#EDF4FF" CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                                Visibility="{Binding HasCandidateBenefit, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_Benefit}" Foreground="#315BB0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding CandidateBenefit}" Foreground="#193F82" Margin="0,3,0,0" FontSize="15" />
                            </StackPanel>
                        </Border>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Evidence}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding IsCandidate, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ReasonText}" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding RecommendationText}" FontSize="14" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding ConditionText}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding SideEffectText}" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"
                                   Visibility="{Binding HasImpact, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ActionModeText}" Style="{StaticResource Muted}" Margin="0,12,0,0" FontSize="12"
                                   Visibility="{Binding ShowManualPathHint, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel>
                            <Button Content="{Binding SettingsButtonText}" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,8,0"
                                    Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Links}" Focusable="False" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Button Content="{Binding Label}" Command="{Binding OpenCommand}" Style="{StaticResource CardButton}"
                                                          ToolTip="{Binding Url}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Url}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding DetailsButtonText}" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource CardButton}"
                                    Visibility="{Binding CanShowDetails, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{x:Static res:Strings.Button_Keep}" Command="{Binding KeepCommand}" Style="{StaticResource CardButton}"
                                    ToolTip="{x:Static res:Strings.Tooltip_Keep}" Visibility="{Binding HasKeepAction, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding HiddenLinksNote}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding HasHiddenLinks, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding LinkStatusText}" Margin="0,6,0,0" Visibility="{Binding HasLinkStatus, Converter={StaticResource BoolToVisibility}}" />
                        <Border Margin="0,14,0,0" Padding="14" Background="#F5F7FA" CornerRadius="6" Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Card_EvidenceHeader}" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding Evidence}" Margin="0,4,0,10" />
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Details_Header}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Measurements}" Focusable="False">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding DetailText}" Margin="0,4,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock TextWrapping="Wrap" Text="{Binding Detail}" Margin="0,6,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding BenefitText}" Margin="0,6,0,0" Visibility="{Binding HasImpact, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.MainWindow_Title}" />
        <DockPanel Grid.Row="1" Margin="28,12,28,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{x:Static res:Strings.Button_CancelScan}" Command="{Binding CancelScanCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="CancelScanButton" />
                <Button x:Name="StartScanButton" Content="{Binding StartButtonText}" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}"
                        MinWidth="130" AutomationProperties.AutomationId="StartScanButton" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_AppTitle}" FontSize="21" FontWeight="Bold" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock TextWrapping="Wrap" Text="{Binding LastMeasuredText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" AutomationProperties.AutomationId="LastMeasuredText" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding StateText}" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.AutomationId="StateText" />
                </WrapPanel>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,0,28,28">
                <Border Background="#E9EFFD" CornerRadius="12" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding OverviewTitle}" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="OverviewTitle" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding OverviewDescription}" Foreground="#435877" Margin="0,7,0,0" />

                        <TextBlock TextWrapping="Wrap" Text="{Binding DrainingNote}" FontWeight="SemiBold" Margin="0,6,0,0" AutomationProperties.AutomationId="DrainingNote"
                                   Visibility="{Binding HasDrainingNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_Space}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_SpaceHelp}" Style="{StaticResource Muted}" Margin="0,6,0,8" MinHeight="28" />
                            <Button Content="{x:Static res:Strings.Overview_CleanupButton}" Click="OpenCacheTools" IsEnabled="{Binding CanOpenCacheTools}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_Settings}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding SettingsCount}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_SettingsHelp}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_Drivers}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding DriverCount}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <CheckBox IsChecked="{Binding IsOnlineCheckRequested}" IsEnabled="{Binding CanChangeOptions}" ToolTip="{x:Static res:Strings.Toggle_OnlineCheck}"><TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_OnlineToggle}" /></CheckBox>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Padding="12" Background="#FFF2D7" CornerRadius="8" Margin="0,0,0,12" Visibility="{Binding HasElevatedBanner, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding ElevatedBannerText}" Foreground="#644300" AutomationProperties.AutomationId="ElevatedBanner" />
                </Border>

                <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" Margin="0,0,0,8" AutomationProperties.AutomationId="StatusMessage" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
                <WrapPanel Margin="0,0,0,14">
                    <Button Content="{Binding RecommendationsTab}" Command="{Binding ShowRecommendationsCommand}" Margin="0,0,8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" Value="True"><Setter Property="Background" Value="#253652" /><Setter Property="Foreground" Value="White" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="{Binding AllResultsTab}" Command="{Binding ShowAllCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAllResults}" Value="True"><Setter Property="Background" Value="#253652" /><Setter Property="Foreground" Value="White" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" Text="{Binding ResultsDescription}" Style="{StaticResource Muted}" Margin="0,0,0,14" />
                <StackPanel Visibility="{Binding ShowAllResults, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14">
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" MaxWidth="300" HorizontalAlignment="Left" MinWidth="210"
                              AutomationProperties.Name="{x:Static res:Strings.Categories_Header}" AutomationProperties.AutomationId="CategoryList" />
                    <CheckBox IsChecked="{Binding ShowCommunityDetails}" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" Text="{Binding CommunitySummary}" />
                    </CheckBox>
                </StackPanel>
                <Border Style="{StaticResource Tile}" Visibility="{Binding IsResultListEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding EmptyResultsText}" Style="{StaticResource Muted}" />
                        <Button Content="{x:Static res:Strings.Overview_All}" Command="{Binding ShowAllCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding VisibleCards}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.AutomationId="CardList" />

            </StackPanel>
        </ScrollViewer>
                <Expander x:Name="OptionsExpander" Grid.Row="3" Header="{x:Static res:Strings.Overview_Options}" Margin="28,8,28,12">
                    <StackPanel Margin="0,12,0,0">
                        <CheckBox Content="{x:Static res:Strings.Toggle_OnlineCheck}" IsChecked="{Binding IsOnlineCheckRequested}" IsEnabled="{Binding CanChangeOptions}" AutomationProperties.AutomationId="OnlineCheckToggle" />
                        <WrapPanel Margin="0,10,0,8">
                            <Button Content="{x:Static res:Strings.Button_ElevatedRescan}" Command="{Binding RequestElevatedRescanCommand}" Margin="0,0,8,8"
                                    ToolTip="{Binding ElevatedRescanTooltip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="ElevatedRescanButton" />
                            <Button Content="{x:Static res:Strings.Button_Export}" Command="{Binding ExportCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="ExportButton" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding SummaryText}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="SummaryText" />
                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Summary_Disclaimer}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding LastOnlineCheckText}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="LastOnlineCheckText"
                                   Visibility="{Binding HasLastOnlineCheck, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Expander>
    </Grid>
</ui:FluentWindow>
