<!--
@file    : DriverGuideWindow.xaml
@author  : rudals252
@brief   : 드라이버 안내를 별도 창으로 띄우는 얇은 래퍼(본문은 DriverGuideView)
-->
<Window x:Class="PcOptimizer.App.Views.DriverGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PcOptimizer.App.Views"
        Title="드라이버 안내 · 무엇을 받을지" Width="820" Height="780" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppCanvasBrush}" Foreground="{DynamicResource AppTextBrush}"
        FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources><ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PcOptimizer;component/Resources/VisibilityTheme.xaml" /></ResourceDictionary.MergedDictionaries>
</ResourceDictionary></Window.Resources>
    <views:DriverGuideView Margin="20" />
</Window>
