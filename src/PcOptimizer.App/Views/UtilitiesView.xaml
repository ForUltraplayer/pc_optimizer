<!--
@file    : UtilitiesView.xaml
@author  : rudals252
@brief   : 유틸리티 탭 뷰. 외부 도구를 분류별 카드 섹션으로 보여 주고(언제/무엇/주의·안전 배지·절차), 공식 사이트만 연다
-->
<UserControl x:Class="PcOptimizer.App.Views.UtilitiesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PcOptimizer;component/Resources/VisibilityTheme.xaml" /></ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#253652" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#122E73" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="Width" Value="320" />
            <Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Padding" Value="8,3" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#DDF3E8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SafetyText}" Value="주의"><Setter Property="Background" Value="#FFF0CC" /></DataTrigger>
                <DataTrigger Binding="{Binding SafetyText}" Value="되돌릴 수 없음"><Setter Property="Background" Value="#FFD9D9" /></DataTrigger>
            </Style.Triggers>
        </Style>
            </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="컴퓨터를 잘 아는 사람들이 흔히 쓰는 무료·공식 도구입니다. 이 앱은 공식 배포처만 열어 주고 파일은 직접 받습니다. 버전은 사이트에서 최신을 고르세요." Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,16" />
        <ItemsControl ItemsSource="{Binding UtilityGroups}" AutomationProperties.AutomationId="UtilityGroups">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Category}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"><TextBlock TextWrapping="Wrap" Text="{Binding SafetyText}" FontSize="12" /></Border>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Tool.What}" Margin="0,0,0,6" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Tool.When}" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Tool.Caution}" Foreground="#8A5A00" FontSize="12" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Warning}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource Visible}}" />
                                            <StackPanel Visibility="{Binding ShowSteps, Converter={StaticResource Visible}}" Margin="0,8,0,0">
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding}" FontSize="12" Margin="0,0,0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="{Binding ActionText}" Command="{Binding ActCommand}" Style="{StaticResource Primary}" />
                                                <Button Content="{Binding StepsButtonText}" Command="{Binding ToggleStepsCommand}" />
                                                <ItemsControl ItemsSource="{Binding ExtraLinks}" Visibility="{Binding HasExtraLinks, Converter={StaticResource Visible}}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding OpenCommand}" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
