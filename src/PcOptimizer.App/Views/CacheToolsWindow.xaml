<Window x:Class="PcOptimizer.App.Views.CacheToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:PcOptimizer.App.Resources"
        xmlns:views="clr-namespace:PcOptimizer.App.Views"
        Title="{x:Static res:Strings.Cleanup_Title}" Width="720" Height="760" MinWidth="480" MinHeight="400"
        Background="#F4F6FA" Foreground="#19253B" FontFamily="Segoe UI, Malgun Gothic" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" /><Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#253652" /><Setter Property="BorderBrush" Value="#CCD5E2" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#122E73" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Overview_Space}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Cleanup_Goal}" Foreground="#53627A" Margin="0,8,0,20" />
            <Border Margin="0,0,0,16" Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}">
                <views:CleanupOutcomeView DataContext="{Binding Outcome}" />
            </Border>
            <Border Background="White" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#E0E5EE">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Cleanup_StepSelect}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ComboBox ItemsSource="{Binding Tools}" SelectedIndex="{Binding SelectedTool}" IsEnabled="{Binding CanSelectTool}"
                              AutomationProperties.Name="{x:Static res:Strings.Cleanup_SelectTool}" Padding="8" Margin="0,0,0,12" />
                    <Button Content="{x:Static res:Strings.Cleanup_Prepare}" Command="{Binding PrepareCommand}" HorizontalAlignment="Left" />
                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Cleanup_StepPreview}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,12" />
                    <Border Background="#EDF4FF" CornerRadius="7" Padding="14">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Message}" Foreground="#193F82" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Cleanup_Impact}" Foreground="#53627A" FontSize="12" Margin="0,14,0,14" />
                    <Button Content="{x:Static res:Strings.Cleanup_Execute}" Command="{Binding ClearCommand}" Background="#2855D9" Foreground="White" BorderBrush="#2855D9" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#E0E5EE" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Cleanup_WindowsTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.Cleanup_WindowsHelp}" Foreground="#53627A" Margin="0,8,0,12" />
                    <Button Content="{x:Static res:Strings.Cleanup_OpenWindows}" Click="OpenWindowsCleanup" IsEnabled="{Binding CanSelectTool}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
