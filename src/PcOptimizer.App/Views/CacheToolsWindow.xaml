<!-- @file: CacheToolsWindow.xaml / @author: rudals252 / @brief: 공식 도구 캐시 정리 미리보기와 확인 -->
<Window x:Class="PcOptimizer.App.Views.CacheToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:PcOptimizer.App.Resources"
        Title="{x:Static res:Strings.Cleanup_Title}" Width="660" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{x:Static res:Strings.Cleanup_Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="{x:Static res:Strings.Cleanup_Impact}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <ComboBox ItemsSource="{Binding Tools}" SelectedIndex="{Binding SelectedTool}" IsEnabled="{Binding CanSelectTool}"
                      AutomationProperties.Name="{x:Static res:Strings.Cleanup_SelectTool}" Margin="0,0,0,12" />
            <WrapPanel>
                <Button Content="{x:Static res:Strings.Cleanup_Prepare}" Command="{Binding PrepareCommand}" Padding="12,8" Margin="0,0,8,8" />
                <Button Content="{x:Static res:Strings.Cleanup_Execute}" Command="{Binding ClearCommand}" Padding="12,8" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,20" AutomationProperties.LiveSetting="Polite" />
            <Separator />
            <TextBlock Text="{x:Static res:Strings.Cleanup_WindowsHelp}" TextWrapping="Wrap" Margin="0,16,0,12" />
            <Button Content="{x:Static res:Strings.Cleanup_OpenWindows}" Click="OpenWindowsCleanup" IsEnabled="{Binding CanSelectTool}" Padding="12,8" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Window>
