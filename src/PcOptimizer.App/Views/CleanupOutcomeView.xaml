<!--
@file    : CleanupOutcomeView.xaml
@author  : rudals252
@brief   : 최근 정리 결과와 전후 논리 크기 표시
-->
<UserControl x:Class="PcOptimizer.App.Views.CleanupOutcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:PcOptimizer.App.Resources">
    <UserControl.Resources><ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PcOptimizer;component/Resources/VisibilityTheme.xaml" /></ResourceDictionary.MergedDictionaries>
</ResourceDictionary></UserControl.Resources>
    <Border Background="#EDF4FF" CornerRadius="10" Padding="16" BorderBrush="#D4E3FC" BorderThickness="1">
        <StackPanel>
            <WrapPanel>
                <TextBlock Text="{Binding Tool}" Foreground="#315BB0" FontWeight="SemiBold" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Title}" Foreground="#193F82" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <UniformGrid Columns="2" Margin="0,12,0,10">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Cleanup_Before}" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="12" />
                    <TextBlock Text="{Binding BeforeText}" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Cleanup_After}" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="12" />
                    <TextBlock Text="{Binding AfterText}" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" />
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="{Binding ChangeText}" Foreground="#193F82" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.Cleanup_ObservationNote}" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
