<UserControl x:Class="PcOptimizer.App.Views.CleanupOutcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:PcOptimizer.App.Resources">
    <Border Background="#EDF4FF" CornerRadius="10" Padding="16" BorderBrush="#D4E3FC" BorderThickness="1">
        <StackPanel>
            <WrapPanel>
                <TextBlock Text="{Binding Tool}" Foreground="#315BB0" FontWeight="SemiBold" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Title}" Foreground="#193F82" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <UniformGrid Columns="2" Margin="0,12,0,10">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Cleanup_Before}" Foreground="#53627A" FontSize="12" />
                    <TextBlock Text="{Binding BeforeText}" Foreground="#19253B" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Cleanup_After}" Foreground="#53627A" FontSize="12" />
                    <TextBlock Text="{Binding AfterText}" Foreground="#19253B" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" />
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="{Binding ChangeText}" Foreground="#193F82" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.Cleanup_ObservationNote}" Foreground="#53627A" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
