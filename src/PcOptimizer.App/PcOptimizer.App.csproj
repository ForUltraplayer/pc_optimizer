<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>ko-KR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- 한국어 UI 문자열 리소스: 빌드 시 공개 강한 형식 접근자(Strings)를 obj에 생성해 XAML x:Static과 코드에서 쓴다 -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PcOptimizer.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    WPF 마크업 컴파일(MarkupCompilePass1)은 로컬 형식을 참조하는 XAML을 위해 임시 어셈블리를 먼저 컴파일한다.
    이때 강한 형식 리소스 접근자(Strings.Designer.cs)가 Compile 항목에 있어야 하므로 리소스 생성을 먼저 실행한다.
  -->
  <Target Name="GenerateStronglyTypedResourcesBeforeMarkupCompile"
          BeforeTargets="MarkupCompilePass1"
          DependsOnTargets="PrepareResourceNames;ResGen" />

  <!-- 마크업 컴파일용 임시 프로젝트(*_wpftmp)는 ResGen을 실행하지 않으므로, 위에서 만든 접근자 파일을 직접 포함한다 -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Condition="Exists('$(IntermediateOutputPath)Strings.Designer.cs')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
    <ProjectReference Include="..\PcOptimizer.Probes\PcOptimizer.Probes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
