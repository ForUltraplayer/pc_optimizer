<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <!-- 실행 파일 이름은 PcOptimizer.exe. 네임스페이스·리소스 이름(PcOptimizer.App.*)은 그대로 유지한다 -->
    <AssemblyName>PcOptimizer</AssemblyName>
    <RootNamespace>PcOptimizer.App</RootNamespace>
    <Version>0.3.0-preview.5</Version>
    <!-- 자체 제작 아이콘(tools/make-icon.ps1 산출물). 디자이너 아이콘으로 바꿀 때는 이 파일만 교체한다 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 일반 빌드는 framework-dependent + PDB. 단일 파일 속성은 publish profile에만 둔다. -->
  <PropertyGroup>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!--
    항상 관리자 권한으로 실행하므로, 사용자 환경 변수(HKCU\Environment)의 DOTNET_STARTUP_HOOKS로 사용자 폴더 어셈블리가
    관리자 권한 프로세스에 로드되지 않게 시작 훅 지원을 끈다(스펙 §0 심층 방어).
  -->
  <PropertyGroup>
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- 한국어 UI 문자열 리소스: 빌드 시 공개 강한 형식 접근자(Strings)를 obj에 생성해 XAML x:Static과 코드에서 쓴다 -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PcOptimizer.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    WPF 마크업 컴파일(MarkupCompilePass1)은 로컬 형식을 참조하는 XAML을 위해 임시 어셈블리를 먼저 컴파일한다.
    이때 강한 형식 리소스 접근자(Strings.Designer.cs)가 Compile 항목에 있어야 하므로 리소스 생성을 먼저 실행한다.
  -->
  <Target Name="GenerateStronglyTypedResourcesBeforeMarkupCompile"
          BeforeTargets="MarkupCompilePass1"
          DependsOnTargets="PrepareResourceNames;ResGen" />

  <!-- 마크업 컴파일용 임시 프로젝트(*_wpftmp)는 ResGen을 실행하지 않으므로, 위에서 만든 접근자 파일을 직접 포함한다 -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Condition="Exists('$(IntermediateOutputPath)Strings.Designer.cs')" />
  </ItemGroup>

  <ItemGroup>
    <!-- 앱 캐시 규칙과 보호 정책(protect.json)은 Probes 어셈블리에 리소스로 들어가며 출력 폴더로 복사하지 않는다. 배포물의 저작자 표시·라이선스 고지만 복사한다 -->
    <None Include="..\..\rules\LICENSE-winapp2.md" Link="rules\LICENSE-winapp2.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- 배포용 출처·버전 메타데이터(sources.json)만 publish 폴더에 둔다. 실행 시에는 이 사본을 읽지 않고 포함 리소스만 사용한다. -->
    <None Include="..\..\rules\sources.json" Link="rules\sources.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcOptimizer.Tests" />
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
    <ProjectReference Include="..\PcOptimizer.Probes\PcOptimizer.Probes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
