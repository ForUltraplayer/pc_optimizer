<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NeutralLanguage>ko-KR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- 한국어 문자열 리소스: 빌드 시 강한 형식 접근자(CoreStrings)를 obj에 생성한다 -->
    <EmbeddedResource Update="Resources\CoreStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PcOptimizer.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
