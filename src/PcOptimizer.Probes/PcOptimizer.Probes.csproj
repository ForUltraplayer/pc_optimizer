<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <!-- LibraryImport 소스 생성기가 만드는 P/Invoke 마샬링 코드에 필요 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 한국어 문자열 리소스: 빌드 시 강한 형식 접근자(ProbeStrings)를 obj에 생성한다 -->
    <EmbeddedResource Update="Resources\ProbeStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PcOptimizer.Probes.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ProbeStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ProbeStrings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      포함 앱 캐시 규칙(스펙 §5.1·§6): 저장소의 rules\가 원본이며, 빌드 때 이 어셈블리에 리소스로 넣는다.
      앱은 규칙을 파일 시스템(출력 폴더)에서 읽지 않으므로 사용자 쓰기 가능한 폴더의 파일을 바꿔도 적용되지 않는다.
    -->
    <EmbeddedResource Include="..\..\rules\winapp2.ini" Link="rules\winapp2.ini" LogicalName="PcOptimizer.Rules.winapp2.ini" />
    <EmbeddedResource Include="..\..\rules\supplement.ini" Link="rules\supplement.ini" LogicalName="PcOptimizer.Rules.supplement.ini" />
    <EmbeddedResource Include="..\..\rules\rule-metadata.json" Link="rules\rule-metadata.json" LogicalName="PcOptimizer.Rules.rule-metadata.json" />
    <EmbeddedResource Include="..\..\rules\sources.json" Link="rules\sources.json" LogicalName="PcOptimizer.Rules.sources.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
